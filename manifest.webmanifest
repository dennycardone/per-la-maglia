{
  "name": "Per la Maglia",
  "short_name": "Per la Maglia",
  "description": "Ogni tuo gol vale per la tua squadra: scavalca il portiere col cucchiaio e porta punti alla tua tifoseria.",
  "lang": "it",
  "start_url": "./?app=1",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#05080e",
